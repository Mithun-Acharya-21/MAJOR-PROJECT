# Application
APP_NAME=EmotiSense AI
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Privacy: raw user text, audio, images, and video are never persisted by default.
STORE_ANALYSIS_METADATA=false
RAW_INPUT_RETENTION_HOURS=0
MAX_UPLOAD_SIZE_MB=25

# Model/runtime defaults (the model is introduced in later phases).
MODEL_VERSION=untrained-phase-1
DEVICE=auto

