{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroscreen.local/schemas/phase5_experiment_artifact_v1.json",
  "title": "NeuroScreen Phase 5 experiment artifact",
  "description": "Metadata contract for one Phase 5 experiment. Validated by ml/evaluation/artifacts.py. clinical_validation and serving are always false: this is a research prototype, not a clinical tool, and no Phase 5 model is deployable.",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "experiment_id",
    "dataset",
    "modality",
    "feature_configuration",
    "label_definition",
    "evaluation",
    "preprocessing",
    "model",
    "selection",
    "results",
    "environment",
    "timestamps",
    "code_revision",
    "known_limitations",
    "clinical_validation",
    "serving"
  ],
  "properties": {
    "schema_version": { "const": "phase5_experiment_artifact_v1" },
    "phase": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "modality": { "type": "string", "minLength": 1 },
    "dataset": {
      "type": "object",
      "required": ["name", "version", "provenance_reference", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "provenance_reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 8 },
        "n_participants": { "type": ["integer", "null"], "minimum": 0 },
        "n_sessions": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "feature_configuration": { "type": "object" },
    "label_definition": {
      "type": "object",
      "required": ["rule", "positive_class", "definition"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "positive_class": { "type": "integer", "enum": [0, 1] },
        "definition": { "type": "string", "minLength": 1 }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "unit",
        "n_units",
        "n_positive",
        "split_strategy",
        "seeds",
        "fold_assignments_reference",
        "fold_assignments_sha256"
      ],
      "properties": {
        "unit": { "enum": ["participant", "session", "sample", "group"] },
        "n_units": { "type": "integer", "minimum": 0 },
        "n_positive": { "type": "integer", "minimum": 0 },
        "split_strategy": { "type": "string", "minLength": 1 },
        "seeds": { "type": ["array", "object"] },
        "n_folds": { "type": ["integer", "null"], "minimum": 2 },
        "n_repetitions": { "type": ["integer", "null"], "minimum": 1 },
        "fold_assignments_reference": { "type": "string", "minLength": 1 },
        "fold_assignments_sha256": { "type": "string", "minLength": 8 },
        "bootstrap_unit": { "type": ["string", "null"] }
      }
    },
    "preprocessing": {
      "type": "object",
      "required": ["configuration", "fit_partition"],
      "properties": {
        "configuration": { "type": "object" },
        "fit_partition": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "required": ["configuration", "hyperparameters"],
      "properties": {
        "configuration": { "type": "object" },
        "hyperparameters": { "type": "object" },
        "framework": { "type": ["string", "null"] }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "threshold_method",
        "threshold_partition",
        "calibration_method",
        "calibration_partition"
      ],
      "properties": {
        "threshold_method": { "type": "string", "minLength": 1 },
        "threshold_partition": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["outer_evaluation", "locked_test"] }
        },
        "threshold_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reference_threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "calibration_method": { "type": "string", "minLength": 1 },
        "calibration_partition": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["outer_evaluation", "locked_test"] }
        }
      }
    },
    "results": {
      "type": "object",
      "required": ["status", "metrics", "confidence_intervals"],
      "properties": {
        "status": { "enum": ["not_measured", "partial", "measured"] },
        "source": { "type": "string" },
        "note": { "type": "string" },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": ["number", "null"] },
              "unit": { "enum": ["participant", "session", "sample", "group"] },
              "n": { "type": ["integer", "null"], "minimum": 0 },
              "n_positive": { "type": ["integer", "null"], "minimum": 0 },
              "reason": { "type": ["string", "null"] },
              "threshold": { "type": ["number", "null"] }
            }
          }
        },
        "confidence_intervals": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ci_lower": { "type": ["number", "null"] },
              "ci_upper": { "type": ["number", "null"] },
              "ci_level": { "type": ["number", "null"] },
              "ci_method": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["software_versions", "hardware"],
      "properties": {
        "software_versions": {
          "type": "object",
          "required": ["python"],
          "properties": { "python": { "type": "string", "minLength": 1 } }
        },
        "hardware": { "type": "object" }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": { "type": "string", "minLength": 10 },
        "finished_at": { "type": "string", "minLength": 10 }
      }
    },
    "code_revision": { "type": "string", "minLength": 1 },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "clinical_validation": { "const": false },
    "serving": { "const": false }
  }
}
